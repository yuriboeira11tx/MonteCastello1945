      no horizonte. Tamanho e halo no Lens Flare Data.","color":{"r":0.6,"g":0.45,"b":0.2,"a":1.0},"guid":"7a413615-eb32-430a-bd7e-6d5f696ee216","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":4250.0,"yMin":-100.0,"xMax":5150.0,"yMax":1850.0},"label":"REFLEXOS
