  m_Script: {fileID: 11500000, guid: 3f3fbc34bcf34ba4c9e8f05a6ef7b306, type: 3}
  m_Name: jornal_cabedelo
  m_EditorClassIdentifier: Assembly-CSharp::FEB.Archive.HistoricalEvidence
  id: jornal_cabedelo
  title: O desaparecimento do Cabedelo
  dateLabel: "8 de abril de 1942 \u2022 Di\xE1rio Carioca"
  description: "A primeira p\xE1gina noticia o desaparecimento do Cabedelo. A manchete
    apresenta o torpedeamento como certo, enquanto o subt\xEDtulo usa uma formula\xE7\xE3o
    condicional. Compare essas escolhas de linguagem e o que elas permitem afirmar.\n\nA
    not\xEDcia tamb\xE9m registra pedidos de repres\xE1lia. Ela permite investigar
    a repercuss\xE3o p\xFAblica dos ataques, mas n\xE3o demonstra, sozinha, que o
    Brasil j\xE1 havia declarado guerra."
  keyFinding: "Uma fonte de imprensa registra o que se sabia e se discutia em sua
    \xE9poca. A not\xEDcia de abril de 1942 \xE9 anterior \xE0 declara\xE7\xE3o do
    estado de guerra, em agosto."
  image: {fileID: 2800000, guid: a8fdf06f56456534a82deba40c81ec15, type: 3}
  imageCaption: "Fonte de \xE9poca \u2022 consulte a data e a linguagem da manchete."
  citation: "Di\xE1rio Carioca, 8 abr. 1942, primeira p\xE1gina. Reprodu\xE7\xE3o
    fornecida no acervo febmidia."
  sourceUrl: https://bndigital.bn.gov.br/hemeroteca-digital/
  pages:
  - title: "Primeira p\xE1gina \u2022 Reprodu\xE7\xE3o do acervo"
    text: "Di\xE1rio Carioca \u2022 8 de abril de 1942\n\nExamine a manchete, a data
      e as express\xF5es de certeza ou d\xFAvida usadas pelo jornal. Use a roda para
      ampliar a reprodu\xE7\xE3o e arraste para percorrer suas colunas.\n\nA imagem
      reproduz a fonte; as orienta\xE7\xF5es de leitura s\xE3o texto de apoio do
      jogo."
    image: {fileID: 2800000, guid: a8fdf06f56456534a82deba40c81ec15, type: 3}
    caption: "Fonte de \xE9poca \u2022 consulte a data e a linguagem da manchete."
  - title: "Leitura cr\xEDtica \u2022 Texto de apoio"
    text: "A primeira p\xE1gina noticia o desaparecimento do Cabedelo. A manchete
      apresenta o torpedeamento como certo, enquanto o subt\xEDtulo usa uma formula\xE7\xE3o
      condicional. Compare essas escolhas de linguagem e o que elas permitem afirmar.\n\nA
      not\xEDcia tamb\xE9m registra pedidos de repres\xE1lia. Ela permite investigar
      a repercuss\xE3o p\xFAblica dos ataques, mas n\xE3o demonstra, sozinha, que
      o Brasil j\xE1 havia declarado guerra.\n\nQuest\xE3o para o dossi\xEA\nUma
      fonte de imprensa registra o que se sabia e se discutia em sua \xE9poca. A
      not\xEDcia de abril de 1942 \xE9 anterior \xE0 declara\xE7\xE3o do estado de
      guerra, em agosto."
    image: {fileID: 0}
    caption: "Contextualiza\xE7\xE3o escrita para a pesquisa no jogo; n\xE3o \xE9
      transcri\xE7\xE3o integral do jornal."
  chronologyLabel: "Not\xEDcia sobre o Cabedelo"
  chronologyOrder: 0
  inspectionPrefab: {fileID: 5760285545952390909, guid: 105e8216ba7532841a0f0bf1145968d0, type: 3}
  inspectionRotation: {x: 6, y: -14, z: -3}
