  m_Script: {fileID: 11500000, guid: 9428a9180c93f7641bf99ce40d560f0c, type: 3}
  m_Name: Acampamentos_da_FEB
  m_EditorClassIdentifier: Assembly-CSharp::FEB.Archive.ArchiveCaseDefinition
  caseId: acampamentos_da_feb
  title: Acampamento
  fieldStudy: 1
  mission: "O arquivo recebeu tr\xEAs fotografias da campanha da It\xE1lia. Procure as barracas de San Rossore no arm\xE1rio met\xE1lico, a hora do rancho sobre as caixas de arquivo e o pracinha escrevendo \xE0 fam\xEDlia no balc\xE3o ao lado da porta. Examine e registre cada fonte.\n\nNo quadro da exposi\xE7\xE3o, associe cada foto a um aspecto da vida em campanha. Responda \xE0s perguntas na caderneta e procure a mesa com a tenda e o fuzil M1 Garand para visitar o acampamento."
  evidence:
  - {fileID: 11400000, guid: 912ee55057af4c92ab50933de6307101, type: 2}
  - {fileID: 11400000, guid: 912ee55057af4c92ab50933de6307102, type: 2}
  - {fileID: 11400000, guid: 912ee55057af4c92ab50933de6307103, type: 2}
  requiredFieldEvidence:
  - {fileID: 11400000, guid: 7009238f0c10205489a7fc1dfcbdee3c, type: 2}
  - {fileID: 11400000, guid: b2d552dbbfc84ea1b5ca41f6188d5abe, type: 2}
  - {fileID: 11400000, guid: b4d50f02fa374656a65b86480723ce49, type: 2}
  - {fileID: 11400000, guid: 03c745e6b0bd1a9478b66e0428912406, type: 2}
