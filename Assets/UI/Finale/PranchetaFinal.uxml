<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../Archive/InspecaoDeCampo.uss" />
    <ui:Style src="PranchetaFinal.uss" />
    <ui:VisualElement name="reportRoot" class="report-root">
        <ui:VisualElement class="clipboard">
            <ui:VisualElement class="report-paper">
                <ui:ScrollView name="reportScroll" class="file-scroll report-scroll" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement class="report-topline"><ui:Label text="MONTE CASTELLO 1945" /><ui:Label name="reportDate" /></ui:VisualElement>
                    <ui:Label text="Relatório de pesquisa" class="report-title" />
                    <ui:Label name="testNotice" class="report-kicker" />
                    <ui:VisualElement class="student-identification">
                        <ui:TextField name="studentName" label="Nome do aluno" max-length="120" class="student-name" />
                        <ui:Label name="studentNameHelp" class="report-note" />
                        <ui:Button name="confirmStudentName" text="Confirmar nome e emitir relatório" class="confirm-name" />
                    </ui:VisualElement>
                    <ui:VisualElement class="report-metric">
                        <ui:VisualElement class="metric-line"><ui:Label text="Acertos na primeira tentativa" class="metric-heading" /><ui:Label name="firstScore" class="metric-value" /></ui:VisualElement>
                        <ui:Label name="firstPercent" class="metric-detail" />
                        <ui:Label name="attempts" class="metric-detail" />
                    </ui:VisualElement>
                    <ui:VisualElement class="report-metric">
                        <ui:VisualElement class="metric-line"><ui:Label text="Tempo de pesquisa" class="metric-heading" /><ui:Label name="totalTime" class="metric-value" /></ui:VisualElement>
                        <ui:Label name="timeDetail" class="metric-detail" />
                    </ui:VisualElement>
                    <ui:VisualElement class="report-summary"><ui:Label name="completion" /><ui:Label name="evidenceCount" /></ui:VisualElement>
                    <ui:Label name="historyNotice" class="report-note" />
                    <ui:VisualElement class="report-identification"><ui:Label text="Identificação do relatório" class="metric-heading" /><ui:Label name="reportCode" class="report-code" /><ui:Label name="integrity" class="report-note" /></ui:VisualElement>
                    <ui:Foldout name="questionDetails" text="Ver respostas da pesquisa" value="false" class="question-details"><ui:VisualElement name="questionResults" /></ui:Foldout>
                </ui:ScrollView>
                <ui:VisualElement class="report-actions"><ui:Button name="copyJwt" text="Copiar JWT" class="primary" /><ui:Button name="exportReport" text="Exportar JSON" /><ui:Button name="showCredits" text="Créditos finais" /></ui:VisualElement>
                <ui:Label name="exportStatus" class="report-note export-status" />
                <ui:Button name="closeReport" text="Voltar ao acervo" class="back-to-archive" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
