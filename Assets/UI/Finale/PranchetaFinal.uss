.report-root {
    --report-ink: #30352a;
    --report-muted: #565344;
    --report-rule: #a89c7c;
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    display: none; align-items: center; justify-content: center;
    background-color: rgba(9, 13, 10, 0.94); color: var(--report-ink);
    -unity-font-definition: url("../Fonts/LiberationSans.asset");
    font-size: 18px;
}
.clipboard {
    width: 78%; max-width: 980px; height: 92%;
    background-color: #454733; padding: 6px;
}
.report-paper {
    flex-grow: 1; min-height: 0; padding: 30px 38px 14px;
    background-color: #e7dcc1; background-image: url("../Archive/Papeis/PapelDeArquivo.png");
    -unity-background-scale-mode: stretch-to-fill;
}
.report-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; margin: 0; }
.report-scroll .unity-scroll-view__content-viewport { padding-right: 14px; min-height: 0; }
.report-scroll .unity-scroll-view__content-container { flex-shrink: 0; }
.report-scroll Label, .report-topline, .report-metric, .metric-line,
.report-summary, .report-identification, .student-identification,
.question-details, #questionResults, .question-result { flex-shrink: 0; }
.report-topline { flex-direction: row; justify-content: space-between; font-size: 15px; color: var(--report-muted); }
.report-topline > Label { -unity-font-definition: url("../Fonts/SpecialElite.asset"); }
.report-title { font-size: 30px; margin: 18px 0 5px; white-space: normal; -unity-font-definition: url("../Fonts/SpecialElite.asset"); }
.report-kicker { font-size: 15px; color: var(--report-muted); white-space: normal; }
.student-identification { margin: 20px 0 10px; }
.student-name { flex-direction: column; margin: 0; font-size: 18px; }
.student-name > Label { min-width: 0; margin: 0 0 5px; color: var(--report-ink); -unity-font-definition: url("../Fonts/SpecialElite.asset"); }
.student-name .unity-text-field__input {
    background-color: rgba(255, 252, 237, 0.45); color: var(--report-ink);
    border-width: 0; border-bottom-width: 1px; border-bottom-color: var(--report-rule);
    border-radius: 0; padding: 7px 6px; min-height: 36px;
}
.student-name .unity-text-field__input:focus { border-bottom-width: 2px; border-bottom-color: #465137; }
.report-issued .student-name .unity-text-field__input { background-color: transparent; padding-left: 0; }
.report-issued #studentNameHelp { display: none; }
.report-note { white-space: normal; font-size: 16px; color: var(--report-muted); margin: 8px 0 0; }
.report-root .report-identification { display: none; }
.report-issued .report-identification { display: flex; }
.report-metric { padding: 12px 0; border-bottom-width: 1px; border-bottom-color: var(--report-rule); }
.metric-line { flex-direction: row; justify-content: space-between; align-items: center; }
.metric-heading { font-size: 18px; white-space: normal; margin-right: 12px; }
.metric-line > .metric-heading { flex-shrink: 1; }
.metric-value { font-size: 23px; -unity-font-definition: url("../Fonts/SpecialElite.asset"); white-space: normal; }
.metric-detail { font-size: 16px; white-space: normal; margin: 5px 0 0; color: var(--report-muted); }
.report-summary { margin-top: 12px; }
.report-summary > Label { white-space: normal; font-size: 17px; margin: 2px 0; }
.report-identification { margin-top: 20px; padding-top: 16px; border-top-width: 1px; border-top-color: var(--report-rule); }
.report-code { font-size: 22px; margin: 8px 0 0; -unity-font-definition: url("../Fonts/SpecialElite.asset"); white-space: normal; }
.question-details { margin: 20px 0 12px; }
.question-details > .unity-toggle { margin-left: 0; min-height: 34px; }
.question-details > .unity-toggle > .unity-toggle__input > .unity-toggle__text { font-size: 18px; color: var(--report-ink); -unity-font-style: bold; }
.question-details > .unity-foldout__content { margin-left: 0; padding-left: 0; }
.result-group { font-size: 20px; margin: 18px 0 8px; -unity-font-definition: url("../Fonts/SpecialElite.asset"); }
.question-result { padding: 10px 0; border-bottom-width: 1px; border-bottom-color: #bbad8c; }
.result-prompt { white-space: normal; font-size: 18px; }
.result-detail { white-space: normal; font-size: 16px; color: var(--report-muted); margin-top: 5px; }
.report-actions { flex-direction: row; flex-shrink: 0; margin-top: 12px; border-top-width: 1px; border-top-color: var(--report-rule); padding-top: 12px; }
.report-actions > Button { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 40px; margin: 0 6px 0 0; padding: 6px 8px; font-size: 17px; -unity-text-align: middle-center; }
.report-actions > #showCredits { margin-right: 0; }
.report-paper Button { background-color: transparent; border-width: 1px; border-color: #7b7d60; border-radius: 0; color: var(--report-ink); white-space: normal; }
.report-paper Button:hover, .report-paper Button:focus { background-color: rgba(70, 81, 55, 0.12); border-color: #465137; }
.report-paper Button:active { background-color: rgba(70, 81, 55, 0.24); }
.report-paper Button:disabled { opacity: 0.45; }
.report-paper .primary { background-color: #465137; color: #f3ebd6; border-color: #465137; }
.report-paper .primary:hover, .report-paper .primary:focus { background-color: #586246; }
.report-paper .primary:active { background-color: #343e29; }
.submission-status { flex-shrink: 0; font-size: 15px; max-height: 74px; overflow: hidden; }
.report-paper .back-to-archive { flex-shrink: 0; align-self: center; margin-top: 6px; border-width: 0; min-height: 30px; font-size: 16px; padding: 4px 10px; }
.report-compact .clipboard { width: 95%; height: 96%; padding: 4px; }
.report-compact .report-paper { padding: 18px 22px 10px; }
.report-compact .report-title { font-size: 26px; margin-top: 12px; }
.report-compact .report-topline { font-size: 14px; }
.report-compact .report-metric { padding: 9px 0; }
.report-compact .metric-value { font-size: 21px; }
.report-compact .report-actions > Button { font-size: 16px; min-height: 36px; }
.report-compact .student-identification { margin-top: 14px; }
