.archive-half { position: absolute; left: 0; top: 0; bottom: 0; width: 50%; background-color: black; border-right-width: 1px; border-right-color: rgb(58, 65, 53); }
.archive-video { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.navigation-half { position: absolute; left: 50%; right: 0; top: 0; bottom: 0; }
.navigation-full { left: 0; }
.final-fade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: black; }
.navigation-image { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.naval-radar { position: absolute; right: 28px; bottom: 28px; width: 280px; height: 280px; }
.outcome { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(27, 31, 24); align-items: center; justify-content: center; }
.archive-sheet { width: 82%; height: 88%; max-width: 1600px; background-color: rgb(220, 208, 177); border-width: 2px; border-color: rgb(126, 111, 78); padding: 38px 65px; align-items: center; }
.sheet-watermark { position: absolute; left: 37%; top: 27%; width: 26%; height: 52%; background-image: url("project://database/Assets/UI/Cutscene/Distintivo_FEB.png"); -unity-background-scale-mode: scale-to-fit; opacity: .065; }
.document-letterhead { width: 100%; height: 160px; flex-direction: row; align-items: center; border-bottom-width: 2px; border-bottom-color: rgb(104, 91, 62); padding-bottom: 20px; }
.feb-emblem { width: 110px; height: 140px; background-image: url("project://database/Assets/UI/Cutscene/Distintivo_FEB.png"); -unity-background-scale-mode: scale-to-fit; }
.brasil-emblem { width: 130px; height: 130px; background-image: url("project://database/Assets/UI/Cutscene/Distintivo_Brasil.png"); -unity-background-scale-mode: scale-to-fit; }
.letterhead-copy { flex-grow: 1; align-items: center; padding-left: 24px; padding-right: 24px; }
.letterhead-title { font-size: 36px; color: rgb(51, 56, 39); -unity-text-align: middle-center; white-space: normal; }
.letterhead-subtitle { font-size: 22px; margin-top: 15px; color: rgb(91, 78, 52); -unity-text-align: middle-center; white-space: normal; }
.record-title { font-size: 25px; color: rgb(91, 78, 52); margin-top: 30px; letter-spacing: 3px; }
.archive-stamp { width: 75%; height: 38%; background-image: url("project://database/Assets/UI/Cutscene/Arquivado.png"); -unity-background-scale-mode: scale-to-fit; }
.outcome-message { color: rgb(53, 46, 37); font-size: 32px; -unity-text-align: middle-center; white-space: normal; width: 92%; margin-top: 12px; }
.document-footer { position: absolute; left: 65px; right: 65px; bottom: 36px; flex-direction: row; justify-content: space-between; border-top-width: 1px; border-top-color: rgb(133, 116, 79); padding-top: 18px; color: rgb(91, 78, 52); font-size: 18px; }
.tribute { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: #080a09; align-items: center; justify-content: center; color: #eee6d3; -unity-font-definition: url("../Fonts/LiberationSans.asset"); }
.tribute-content { width: 84%; max-width: 1400px; height: 88%; align-items: center; justify-content: center; }
.tribute-heading { font-size: 45px; -unity-font-definition: url("../Fonts/AllertaStencil.asset"); -unity-text-align: middle-center; white-space: normal; width: 100%; margin-bottom: 34px; flex-shrink: 0; }
.tribute-message { width: 90%; font-size: 32px; -unity-text-align: middle-center; white-space: normal; margin-bottom: 32px; flex-shrink: 0; }
.tribute-count { width: 100%; font-size: 34px; -unity-text-align: middle-center; white-space: normal; color: #d4d0c0; margin-top: 12px; flex-shrink: 0; }
.tribute-photo { width: 78%; height: 60%; max-height: 600px; flex-shrink: 1; }
.tribute-caption { width: 100%; font-size: 25px; -unity-text-align: middle-center; white-space: normal; color: #c8c8b4; margin-top: 26px; flex-shrink: 0; -unity-font-definition: url("../Fonts/SpecialElite.asset"); }
