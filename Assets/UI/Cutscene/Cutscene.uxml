<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:feb="FEB.UI">
    <ui:Style src="Cutscene.uss" />
    <ui:VisualElement name="cutsceneRoot" class="screen" picking-mode="Ignore">
        <ui:VisualElement class="archive-half" picking-mode="Ignore">
            <ui:Image name="archiveVideo" class="archive-video" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="navigation-half" picking-mode="Ignore">
            <ui:Image name="navigationView" class="navigation-image" picking-mode="Ignore" />
            <feb:NavalRadar name="navalRadar" class="naval-radar" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="finalFade" class="final-fade hidden" picking-mode="Ignore" />
        <ui:VisualElement name="outcome" class="outcome hidden" picking-mode="Ignore">
            <ui:VisualElement class="archive-sheet" picking-mode="Ignore">
                <ui:VisualElement class="sheet-watermark" picking-mode="Ignore" />
                <ui:VisualElement class="document-letterhead" picking-mode="Ignore">
                    <ui:VisualElement class="feb-emblem" picking-mode="Ignore" />
                    <ui:VisualElement class="letterhead-copy" picking-mode="Ignore">
                        <ui:Label text="FORÇA EXPEDICIONÁRIA BRASILEIRA" class="letterhead-title stencil" picking-mode="Ignore" />
                        <ui:Label text="ARQUIVO HISTÓRICO · REGISTRO DE MANOBRA" class="letterhead-subtitle typewriter" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="brasil-emblem" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="FICHA DO RECRUTA" class="record-title typewriter" picking-mode="Ignore" />
                <ui:Image name="archiveStamp" class="archive-stamp" picking-mode="Ignore" />
                <ui:Label name="outcomeMessage" class="outcome-message typewriter" picking-mode="Ignore" />
                <ui:VisualElement class="document-footer" picking-mode="Ignore">
                    <ui:Label text="SITUAÇÃO: NOVA TENTATIVA NECESSÁRIA" class="typewriter" picking-mode="Ignore" />
                    <ui:Label text="MONTE CASTELLO: 1945" class="typewriter" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="tribute" class="tribute hidden" picking-mode="Ignore">
            <ui:VisualElement name="tributeContent" class="tribute-content" picking-mode="Ignore">
                <ui:Label name="tributeHeading" class="tribute-heading" picking-mode="Ignore" />
                <ui:Label name="tributeMessage" class="tribute-message" picking-mode="Ignore" />
                <ui:Image name="tributePhoto" class="tribute-photo hidden" picking-mode="Ignore" />
                <ui:Label name="tributeCaption" class="tribute-caption hidden" picking-mode="Ignore" />
                <ui:Label name="tributeCount" class="tribute-count" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
