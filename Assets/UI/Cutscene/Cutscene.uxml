            <ui:Label text="um jogo sério inspirado na trajetória da força expedicionária brasileira" class="opening-description title-shadow typewriter" picking-mode="Ignore" />
            <ui:Label text="Monte Castello: 1945" class="opening-title stencil" picking-mode="Ignore" />
            <ui:Label text="um jogo sério inspirado na trajetória da força expedicionária brasileira" class="opening-description typewriter" picking-mode="Ignore" />
