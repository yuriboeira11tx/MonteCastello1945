.loading-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: #000000;
    justify-content: center;
    align-items: center;
}

.loading-exhibit {
    width: 88%;
    height: 70%;
    max-width: 1500px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 4%;
}

.loading-object {
    flex-basis: 0;
    flex-grow: 1.16;
    height: 100%;
    min-width: 0;
}

.loading-caption {
    flex-basis: 0;
    flex-grow: 1;
    min-width: 0;
    padding-left: 4%;
    padding-right: 3%;
}

.loading-title {
    color: #ede7d6;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/AllertaStencil.asset");
    font-size: 39px;
    white-space: normal;
}

.loading-rule {
    height: 2px;
    width: 51px;
    margin-top: 15px;
    margin-bottom: 19px;
    background-color: #a99158;
}

.loading-fact {
    color: #c7c3b6;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/LiberationSans.asset");
    font-size: 22px;
    white-space: normal;
}

.loading-signature {
    position: absolute;
    right: 4%; bottom: 4%;
    flex-direction: row;
    align-items: flex-end;
}

.loading-status {
    color: #b4aa90;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/SpecialElite.asset");
    font-size: 16px;
    margin-right: 15px;
    margin-bottom: 3px;
}

.loading-insignia {
    width: 66px;
    height: 79.47px;
    background-image: url("project://database/Assets/UI/Cutscene/Distintivo_FEB.png");
    background-size: contain;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: #ded7c7;
}

.loading-smoke {
    position: absolute;
    left: 51%;
    bottom: 54%;
    width: 91%;
    height: 127%;
}

.loading-narrow .loading-exhibit {
    flex-direction: column;
    height: 73%;
    width: 84%;
    margin-bottom: 12%;
}
.loading-narrow .loading-object { width: 100%; height: 0; flex-grow: 1; }
.loading-narrow .loading-caption {
    width: 100%;
    flex-grow: 0;
    flex-basis: auto;
    padding: 10px 0 0;
}
.loading-narrow .loading-title, .loading-short .loading-title { font-size: 28px; }
.loading-narrow .loading-fact, .loading-short .loading-fact { font-size: 18px; }
.loading-narrow .loading-rule, .loading-short .loading-rule { margin-top: 8px; margin-bottom: 10px; }
.loading-narrow .loading-insignia, .loading-short .loading-insignia { width: 42px; height: 50.57px; }
.loading-short .loading-status { font-size: 14px; }
