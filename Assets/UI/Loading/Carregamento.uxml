<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Carregamento.uss" />
    <ui:VisualElement name="loadingRoot" class="loading-screen">
        <ui:VisualElement class="loading-exhibit" picking-mode="Ignore">
            <ui:Image name="loadingObject" class="loading-object" picking-mode="Ignore" />
            <ui:VisualElement class="loading-caption" picking-mode="Ignore">
                <ui:Label name="objectTitle" class="loading-title" picking-mode="Ignore" />
                <ui:VisualElement class="loading-rule" picking-mode="Ignore" />
                <ui:Label name="historicalFact" class="loading-fact" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="loading-signature" picking-mode="Ignore">
            <ui:Label text="Carregando" class="loading-status" picking-mode="Ignore" />
            <ui:VisualElement class="loading-insignia" picking-mode="Ignore">
                <ui:VisualElement name="snakeSmoke" class="loading-smoke" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
