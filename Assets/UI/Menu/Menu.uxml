<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu/Menu.uss?fileID=7433441132597879392&amp;guid=dce487c67f5c44f4bbf3b3a2d855e82a&amp;type=3#Menu"/>
    <ui:VisualElement name="menuRoot" class="screen menu-root">
        <ui:VisualElement name="intro" class="fill intro">
            <ui:Image name="slideshow" source="project://database/Assets/Images/feb-forca-expedicionaria-brasileira-foto-do-pelotao-do-ten-cavalcanti-1280x856-recorte.jpg" scale-mode="StretchToFill" picking-mode="Ignore" class="fill slideshow"/>
            <ui:Label name="introTitle" text="MONTE CASTELLO&#10;1945" picking-mode="Ignore" class="intro-title stencil"/>
            <ui:Label name="introPrompt" text="Pressione qualquer tecla para continuar" picking-mode="Ignore" class="intro-prompt typewriter"/>
        </ui:VisualElement>
        <ui:VisualElement name="options" enabled="true" class="fill options hidden">
            <ui:VisualElement picking-mode="Ignore" class="fill collage"/>
            <ui:VisualElement picking-mode="Ignore" class="menu-shade"/>
            <ui:Label text="MC: 1945" picking-mode="Ignore" class="menu-title stencil"/>
            <ui:VisualElement picking-mode="Ignore" class="title-rule"/>
            <ui:VisualElement class="menu-options">
                <ui:Button name="newGame" class="menu-option typewriter">
                    <ui:VisualElement picking-mode="Ignore" class="menu-caption">
                        <ui:Label text="Novo Jogo" picking-mode="Ignore"/>
                        <ui:VisualElement picking-mode="Ignore" class="menu-underline"/>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="continueGame" class="menu-option typewriter">
                    <ui:VisualElement picking-mode="Ignore" class="menu-caption">
                        <ui:Label text="Continuar Jogo" picking-mode="Ignore"/>
                        <ui:VisualElement picking-mode="Ignore" class="menu-underline"/>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="credits" class="menu-option typewriter">
                    <ui:VisualElement picking-mode="Ignore" class="menu-caption">
                        <ui:Label text="Créditos" picking-mode="Ignore"/>
                        <ui:VisualElement picking-mode="Ignore" class="menu-underline"/>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="quit" class="menu-option typewriter">
                    <ui:VisualElement picking-mode="Ignore" class="menu-caption">
                        <ui:Label text="Sair" picking-mode="Ignore"/>
                        <ui:VisualElement picking-mode="Ignore" class="menu-underline"/>
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:Label text="v1.0&#10;&#10;Yuri Boeira" picking-mode="Ignore" class="menu-credit typewriter"/>
            <ui:Label name="song" text="&quot;Você sabe de onde eu venho?&#10;Venho do morro, do Engenho&#10;Das selvas, dos cafezais&#10;Da boa terra do coco&#10;Da choupana onde um é pouco&#10;Dois é bom, três é demais&#10;Venho das praias sedosas&#10;Das montanhas alterosas&#10;Dos pampas, do seringal&#10;Das margens crespas dos rios&#10;Dos verdes mares bravios&#10;Da minha terra Natal&quot;" picking-mode="Ignore" class="menu-song typewriter" style="color: rgb(164, 164, 164); bottom: -6px; right: 2px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
