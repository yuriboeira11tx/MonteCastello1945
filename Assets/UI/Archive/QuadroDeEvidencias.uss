@import url("project://database/Assets/UI/Archive/Papeis/PapeisDoQuadro.uss");

.board-frame, .board-surface { position: absolute; }
.board-surface {
    width: 1440px;
    height: 648px;
    transform-origin: left top;
    padding: 26px 42px;
    color: #302d23;
}
.board-header, .board-cards, .board-labels, .board-controls {
    flex-direction: row;
    align-items: center;
}
.board-header, .board-controls { justify-content: space-between; flex-shrink: 0; }
.board-header { margin-bottom: 18px; }
.board-title-sheet {
    min-width: 46%;
    rotate: -0.9deg;
    border-bottom-width: 2px;
    border-bottom-color: #907957;
}
.board-heading { -unity-text-align: middle-center; padding: 4px 33px 9px; font-size: 40px; }
.board-header .paper-tape { width: 45px; height: 15px; }
.header-tape-left { left: -8px; top: 1px; rotate: -18deg; }
.header-tape-right { right: -9px; bottom: 2px; rotate: -22deg; }
.board-card, .board-tag, .board-caption, .board-feedback {
    border-width: 0 1px 2px 0;
    border-color: #b6a78c #cbbb9c #998465 #cbbb9c;
}
.board-cards { flex-grow: 1; min-height: 0; align-items: stretch; }
.board-column { flex-grow: 1; flex-basis: 0; min-width: 0; align-items: center; }
.board-card {
    align-items: stretch;
    width: 85%;
    max-width: 350px;
    height: 100%;
    padding: 12px 13px 3px;
    color: #28291f;
    flex-shrink: 0;
}
.board-photo { flex-grow: 1; flex-basis: 0; min-height: 0; align-self: stretch; }
.board-card-title {
    flex-shrink: 0;
    height: 61px;
    margin-top: 6px;
    font-size: 25px;
    -unity-text-align: lower-left;
}
.board-card-date {
    flex-shrink: 0;
    height: 50px;
    margin: 4px 0 2px;
    font-size: 20px;
    color: #484437;
    -unity-text-align: upper-left;
}
.board-pin {
    width: 17px; height: 17px;
    align-self: center; align-items: flex-start;
    flex-shrink: 0;
    background-color: #853524;
    border-width: 2px 2px 3px 2px;
    border-color: #bd7760 #603628 #42291c #a36346;
    border-radius: 10px;
}
.board-glint { width: 5px; height: 3px; margin: 2px 0 0 2px; border-radius: 3px; background-color: #edd0a8; }
.board-labels { justify-content: center; flex-shrink: 0; align-items: stretch; margin: 40px 0 17px; }
.board-tag, .board-caption {
    align-items: center;
    justify-content: center;
    padding: 6px 15px 9px;
    color: #343327;
}
.board-tag { width: 76%; min-height: 66px; }
.board-caption { max-width: 1120px; padding-left: 35px; padding-right: 35px; }
.board-tag-text { -unity-text-align: middle-center; margin-top: 4px; font-size: 25px; }
.board-controls { align-items: stretch; }
.board-feedback {
    font-size: 24px;
    -unity-text-align: middle-left;
    padding: 9px 18px;
    margin-right: 18px;
    min-width: 0;
    flex-shrink: 1;
}
.board-ink .board-feedback.board-error { color: #762c22; }
.board-tool {
    flex-shrink: 0;
    align-self: center;
    -unity-background-image-tint-color: #f3dd97;
    border-width: 0 1px 2px 0;
    border-color: #c9b680 #ad985f #8c794e #baaa87;
    -unity-text-align: middle-center;
    padding: 9px 18px;
    font-size: 24px;
}
.board-card:hover, .board-tag:hover, .board-card:focus, .board-tag:focus,
.board-card.board-selected, .board-tool:focus, .board-tool:hover {
    border-width: 3px;
    border-color: #b49345;
}
.board-card:hover, .board-card:focus, .board-tag:hover, .board-tag:focus { background-color: #faeed0; }
.board-card.board-selected { border-color: #753a27; }
.board-tool:focus, .board-tool:hover { -unity-background-image-tint-color: #ffe9a5; }
.board-thread-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
