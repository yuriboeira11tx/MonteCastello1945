.evidence-prompt {
    position: absolute;
    align-self: center;
    bottom: 15%;
    padding: 10px 24px;
    background-color: rgba(25, 29, 22, 0.91);
    border-bottom-width: 2px;
    border-bottom-color: #a8ad86;
    color: #f2ead2;
    font-size: 26px;
}
.inspection-split {
    flex-direction: row;
    background-color: transparent;
}
.inspection-half {
    flex-shrink: 0;
    min-width: 0;
    min-height: 0;
    padding: 4% 3%;
}
.object-side {
    flex-grow: 1;
    flex-basis: 0;
    background-color: transparent;
    color: #f1e9d2;
}
.dossier-side {
    width: 37%;
    max-width: 820px;
    margin: 2% 2.5% 2% 0;
    padding: 32px 36px;
    color: #302e24;
    background-color: #eee4cc;
    border-width: 1px 2px 3px 1px;
    border-color: #c5b89c;
}
.file-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    flex-shrink: 0;
}
.file-section {
    font-size: 23px;
    color: #586047;
}
.file-title {
    font-size: 53px;
    color: #35422f;
    margin-top: 23px;
}
.file-date {
    font-size: 23px;
    color: #69614d;
    margin-top: 12px;
}
.file-scroll {
    flex-grow: 1;
    min-height: 0;
    margin: 14px 0;
}
.file-scroll .unity-scroll-view__content-and-vertical-scroll-container { flex-direction: row; flex-grow: 1; min-height: 0; }
.file-scroll .unity-scroll-view__content-viewport { flex-grow: 1; min-width: 0; overflow: hidden; }
.file-scroll .unity-scroll-view__content-container { flex-shrink: 0; }
.file-scroll .unity-scroller--vertical { width: 10px; flex-shrink: 0; margin-left: 9px; }
.file-scroll .unity-scroller__slider, .file-scroll .unity-base-slider__input,
.file-scroll .unity-base-slider__drag-container { flex-grow: 1; padding: 0; margin: 0; }
.file-scroll .unity-base-slider__tracker { position: absolute; left: 2px; right: 2px; top: 0; bottom: 0; background-color: #dbd1b9; }
.file-scroll .unity-base-slider__dragger { position: absolute; left: 0; right: 0; min-height: 18px; background-color: #7c8068; border-radius: 4px; }
.file-scroll .unity-scroller__low-button, .file-scroll .unity-scroller__high-button,
.file-scroll .unity-base-slider__dragger-border { display: none; }
.file-divider {
    height: 2px;
    background-color: #ada58c;
    margin-top: 20px;
}
.file-heading { font-size: 34px; color: #444b39; margin: 22px 0 12px; }
.file-body { flex-shrink: 0; font-size: 30px; white-space: normal; }
.file-source { font-size: 23px; color: #5c584a; margin-bottom: 12px; }
.object-viewport { flex-grow: 1; min-height: 0; width: 100%; }
.object-caption { font-size: 23px; color: #e1d8bf; margin: 12px 0; }
.object-tools { border-top-width: 1px; border-top-color: #70735f; padding-top: 12px; }
.object-tools Label { flex-grow: 1; flex-basis: 50%; margin-right: 8px; font-size: 23px; }
.file-footer { border-top-width: 1px; border-top-color: #ada58c; padding-top: 10px; }
.file-status { font-size: 22px; color: #763c30; }
.file-page { font-size: 23px; color: #595d46; }
.inspection-button { min-height: 43px; font-size: 24px; margin: 4px 0; -unity-text-align: middle-center; }
.paper-button { color: #404a35; background-color: rgba(75, 84, 53, 0.08); }
.paper-button:hover, .paper-button:focus { background-color: rgba(75, 84, 53, 0.2); }
.file-register { align-self: flex-end; margin-top: 12px; }
.inspection-split--compact .inspection-half { padding: 14px 18px; }
.inspection-split--compact .dossier-side { width: 44%; margin: 10px 12px 10px 0; }
.inspection-split--compact .file-title { font-size: 33px; margin-top: 12px; }
.inspection-split--compact .file-heading { font-size: 26px; }
.inspection-split--compact .file-body { font-size: 22px; }
.inspection-split--compact .file-row Label, .inspection-split--compact .file-date,
.inspection-split--compact .object-caption, .inspection-split--compact .file-source { font-size: 18px; }
.inspection-split--compact .inspection-button { min-height: 34px; padding: 4px 10px; font-size: 18px; }
