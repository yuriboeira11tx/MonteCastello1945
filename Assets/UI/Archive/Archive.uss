.objective-backdrop { position: absolute; left: 34px; top: 28px; width: 700px; height: 230px; background-color: rgba(14, 17, 11, 0.88); }
.archive-heading { position: absolute; left: 58px; top: 44px; width: 640px; height: 42px; font-size: 30px; color: rgb(232, 219, 179); }
.progress { position: absolute; left: 58px; top: 92px; width: 640px; height: 36px; font-size: 24px; color: rgb(209, 207, 171); }
.objective { position: absolute; left: 58px; top: 141px; width: 640px; height: 100px; font-size: 27px; }
.interaction { position: absolute; left: 50%; margin-left: -350px; bottom: 220px; width: 700px; height: 50px; font-size: 28px; -unity-text-align: middle-center; }
.crosshair { position: absolute; left: 50%; top: 50%; margin-left: -15px; margin-top: -20px; width: 30px; height: 40px; font-size: 32px; -unity-text-align: middle-center; }
.commands { position: absolute; left: 48px; bottom: 28px; height: 35px; font-size: 22px; color: rgb(209, 207, 171); }
.document-panel { background-color: rgba(4, 5, 4, 0.91); align-items: center; justify-content: center; }
.notebook { width: 1800px; height: 1000px; flex-shrink: 0; color: rgb(48, 41, 27); background-image: url("project://database/Assets/Art/Environment/ArquivoHistorico/UI/Caderneta_Aberta.png"); background-size: 100% 100%; }
.document-title { position: absolute; left: 115px; top: 108px; width: 650px; height: 80px; font-size: 41px; }
.document-subtitle { position: absolute; left: 115px; top: 196px; width: 650px; height: 42px; font-size: 23px; }
.document-rule { position: absolute; left: 115px; top: 248px; width: 650px; height: 2px; background-color: rgba(84, 77, 51, 0.4); }
.archive-stamp { position: absolute; left: 160px; top: 350px; width: 570px; height: 320px; font-size: 74px; -unity-text-align: middle-center; color: rgba(97, 99, 66, 0.65); }
.document-image { position: absolute; left: 115px; top: 310px; width: 650px; height: 460px; }
.inspection-help { position: absolute; left: 115px; top: 777px; width: 650px; height: 28px; font-size: 20px; color: rgb(97, 82, 56); }
.reset-inspection { position: absolute; left: 505px; top: 263px; width: 260px; height: 42px; font-size: 23px; }
.image-caption { position: absolute; left: 115px; top: 826px; width: 650px; height: 44px; font-size: 20px; }
.citation { position: absolute; left: 115px; top: 881px; width: 650px; height: 55px; font-size: 17px; color: rgb(97, 82, 56); }
.notes-heading { position: absolute; left: 1000px; top: 88px; width: 675px; height: 82px; font-size: 28px; color: rgb(97, 82, 56); }
.body-scroll { position: absolute; left: 1000px; top: 205px; width: 675px; height: 330px; }
.document-body { font-size: 26px; flex-shrink: 0; }
.choices { position: absolute; left: 1000px; top: 563px; width: 675px; }
.choices > Button { height: 52px; margin-bottom: 6px; flex-shrink: 0; font-size: 23px; }
.zoom-button { position: absolute; left: 115px; top: 263px; width: 250px; height: 42px; font-size: 23px; }
.close-button { position: absolute; left: 1650px; top: 55px; width: 50px; height: 45px; padding: 0; -unity-text-align: middle-center; }
.zoom-panel { background-color: rgba(5, 6, 5, 0.99); }
.zoom-image { position: absolute; left: 50%; top: 50%; margin-left: -875px; margin-top: -455px; width: 1750px; height: 950px; }
.zoom-close { position: absolute; right: 60px; top: 24px; width: 390px; height: 56px; font-size: 27px; }
.transition { background-color: black; opacity: 0; }
.body-scroll .unity-scroll-view__content-and-vertical-scroll-container { flex-grow: 1; flex-direction: row; min-height: 0; }
.body-scroll .unity-scroll-view__content-viewport { flex-grow: 1; min-width: 0; overflow: hidden; }
.body-scroll .unity-scroll-view__content-container { flex-shrink: 0; }
.unity-scroller--vertical { width: 8px; margin-left: 6px; flex-shrink: 0; }
.unity-scroller__slider, .unity-base-slider__input, .unity-base-slider__drag-container { flex-grow: 1; margin: 0; padding: 0; }
.unity-base-slider__tracker { position: absolute; left: 2px; right: 2px; top: 0; bottom: 0; background-color: rgba(97, 82, 56, 0.12); }
.unity-base-slider__dragger-border { display: none; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-base-slider__dragger { position: absolute; left: 0; right: 0; background-color: rgba(97, 82, 56, 0.5); border-radius: 3px; min-width: 6px; min-height: 16px; }
