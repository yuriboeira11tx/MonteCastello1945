--- !u!114 &1332469427
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1332469426}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6acf21efb04ef094d8c1f65db2770bbb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FEB.Cinematics.CampArrival
  pesquisador: {fileID: 884951834}
  motorista: {fileID: 1836715152}
  capitao: {fileID: 624939225}
  jipe: {fileID: 492018237}
  inicioDoTrajeto: {fileID: 2103381260}
  cameraDoPassageiro: {fileID: 1387623032}
  vozes: {fileID: 71304150}
  motor: {fileID: 2018414091}
  efeitos: {fileID: 1973953807}
  vozDoCapitao: {fileID: 1510682835}
  vozDoMotorista: {fileID: 839529481}
  ganhoDasVozesNaChegada: 1.35
  papel: {fileID: 8300000, guid: 626d2f69c79df124d883804fef0afe5f, type: 3}
  passos: {fileID: 11400000, guid: 23cb1e997331e2542845ab6b9e957076, type: 2}
  dialogo:
    chegada:
      gravacao: {fileID: 8300000, guid: fb49afa282bbe3841ab62e80170fce13, type: 3}
      segundosSemGravacao: 7.944
      legendas:
      - inicio: 0.04405841
        texto: "\xD4, Costa! Costa! Costa! Pera\xED, pera\xED!"
      - inicio: 0.4405841
        texto: "Tem cigarro a\xED?"
      - inicio: 0.7590635
        texto: "Quem que \xE9 esse a\xED?"
    apresentacao:
      gravacao: {fileID: 0}
      segundosSemGravacao: 8.823529
      legendas:
      - inicio: 0
        texto: "Meu capit\xE3o! Trouxe o pesquisador que o comando anunciou."
      - inicio: 0.38000003
        texto: Veio ouvir o pessoal e escrever sobre a vida aqui no acampamento.
      - inicio: 0.8133334
        texto: "\xC9 pra publicar l\xE1 no Brasil."
    suspeita:
      gravacao: {fileID: 8300000, guid: 56701fce336065349be1c439d5b68b92, type: 3}
      segundosSemGravacao: 44.376
      legendas:
      - inicio: 0.004506941
        texto: "Ah, publicar, \xE9? Pesquisador, voc\xEA n\xE3o tem nenhum cigarro a\xED, n\xE3o?"
      - inicio: 0.11154678
        texto: "N\xE3o?"
      - inicio: 0.15210925
        texto: "Escuta aqui. Como \xE9 que eu sei que ele n\xE3o \xE9 um espi\xE3o da R\xE1dio Auriverde?"
      - inicio: 0.29520464
        texto: "Todo mundo j\xE1 ouviu a r\xE1dio aqui. Aquelas conversas dos alem\xE3es em portugu\xEAs\u2026"
      - inicio: 0.45069408
        texto: "\u201C\xD4, pracinha, que saudade de casa, hein?\u201D"
      - inicio: 0.5408329
        texto: "Ah, eu odeio aquela r\xE1dio."
      - inicio: 0.59716964
        texto: "N\xE3o sei o que os alem\xE3es t\xEAm na cabe\xE7a, achando que a gente vai mudar de ideia,"
      - inicio: 0.6963223
        texto: "largar o fuzil e ir embora s\xF3 porque eles chamam a gente de amigo."
      - inicio: 0.7932216
        texto: "Mas, \xF4 Costa, pega a credencial dele a\xED. Deixa eu conferir."
      - inicio: 0.9002614
        texto: "T\xE1 um pouco esquisita essa hist\xF3ria."
    credencial:
      gravacao: {fileID: 0}
      segundosSemGravacao: 6.5
      legendas:
      - inicio: 0
        texto: "Aqui, meu capit\xE3o."
      - inicio: 0.23076923
        texto: "E se ele escrever tudo que ouviu no jipe, pe\xE7o licen\xE7a pra riscar umas duas palavras."
    missao:
      gravacao: {fileID: 8300000, guid: c5ff44a79c32a894eb65607a927ee11a, type: 3}
      segundosSemGravacao: 31.344
      legendas:
      - inicio: 0.0038284839
        texto: "\xC9, Costa, se ele for um espi\xE3o, voc\xEA t\xE1 ferrado."
      - inicio: 0.114854515
        texto: "Deixa eu ver aqui. Nome, assinatura\u2026 Parece que t\xE1 certo."
      - inicio: 0.31265953
        texto: Seja bem-vindo.
      - inicio: 0.41794285
        texto: "Voc\xEA tem alguma ordem, Costa?"
      - inicio: 0.47537008
        texto: "Se n\xE3o, sugiro que voc\xEA leve ele l\xE1 na enfermaria."
      - inicio: 0.57746303
        texto: "Pergunte \xE0s enfermeiras a\xED como \xE9 que foi a noite passada."
      - inicio: 0.6731751
        texto: "E n\xE3o atrapalhe ningu\xE9m."
      - inicio: 0.7369832
        texto: "E procure cigarro. Se encontrar cigarro, eu troco por\u2026"
      - inicio: 0.8821465
        texto: "Vai l\xE1, vai l\xE1."
      - inicio: 0.94595456
        texto: Com cuidado, hein?
  segundosIniciaisNoEscuro: 3
  segundosDeTrajeto: 7
  credencial: {fileID: 1680341367}
  pontoDeEntrega: {fileID: 1289238144}
