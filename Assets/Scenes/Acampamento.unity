--- !u!114 &71304150
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 71304149}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c8d8db1731c37c541ba4f58e806a3043, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FEB.Audio.SceneDialogue
  pesquisador: {fileID: 884951834}
  voz: {fileID: 1637811062}
  alcance: 5
  intervalo: 7
  esperaInicial: 1.5
  falas:
  - identificador: chegada
    locutor: Pesquisador
    quando: 0
    origem: {fileID: 0}
    evidencia: {fileID: 0}
    texto: Na fotografia, eu via fileiras de barracas. Daqui de baixo, quase perco a conta.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: rancho
    locutor: Pesquisador
    quando: 2
    origem: {fileID: 791235494}
    evidencia: {fileID: 0}
    texto: "Da cozinha at\xE9 a \xFAltima barraca, algu\xE9m tinha de levar cada refei\xE7\xE3o."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: instrucao
    locutor: Pesquisador
    quando: 2
    origem: {fileID: 206729138}
    evidencia: {fileID: 0}
    texto: "Daqui eu ou\xE7o a contagem. \xC0 dist\xE2ncia, na fotografia, mal se distinguia um homem do outro."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: enfermagem
    locutor: Pesquisador
    quando: 3
    origem: {fileID: 0}
    evidencia: {fileID: 11400000, guid: 7009238f0c10205489a7fc1dfcbdee3c, type: 2}
    texto: Pistoia. Marquei o nome na caderneta. Foi ali que as enfermeiras posaram para esse retrato.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_01
    locutor: Guarda de fuzil
    quando: 1
    origem: {fileID: 624939223}
    evidencia: {fileID: 0}
    texto: "Se o cabo perguntar por mim, estou de servi\xE7o at\xE9 o rancho."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_02
    locutor: "Soldado em instru\xE7\xE3o"
    quando: 1
    origem: {fileID: 617227182}
    evidencia: {fileID: 0}
    texto: "Um, dois\u2026 Agora acertei o passo."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_03
    locutor: "Soldado em instru\xE7\xE3o"
    quando: 1
    origem: {fileID: 327333035}
    evidencia: {fileID: 0}
    texto: "A terra vem junto na palma da m\xE3o."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_04
    locutor: "Soldado em instru\xE7\xE3o"
    quando: 1
    origem: {fileID: 1968054159}
    evidencia: {fileID: 0}
    texto: "Sete\u2026 Oito\u2026 Quem foi que disse que eram s\xF3 seis?"
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_05
    locutor: Patrulheiro
    quando: 1
    origem: {fileID: 1974870410}
    evidencia: {fileID: 0}
    texto: "Mais uma volta pelas barracas. Depois \xE9 a minha vez de tomar caf\xE9."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_06
    locutor: Soldado em descanso
    quando: 1
    origem: {fileID: 990617011}
    evidencia: {fileID: 0}
    texto: "Algu\xE9m me empresta um l\xE1pis? Deixei a carta pela metade."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_07
    locutor: Soldado do transporte
    quando: 1
    origem: {fileID: 1955207697}
    evidencia: {fileID: 0}
    texto: "Abra caminho, camarada. Com essa caixa mal vejo os meus p\xE9s."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_08
    locutor: Soldado do transporte
    quando: 1
    origem: {fileID: 618659450}
    evidencia: {fileID: 0}
    texto: O cozinheiro pediu essa aqui. A outra volta comigo.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_09
    locutor: Soldado do transporte
    quando: 1
    origem: {fileID: 1147529890}
    evidencia: {fileID: 0}
    texto: Esta vai pro posto. Deixa as ataduras por cima.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_10
    locutor: Patrulheiro
    quando: 1
    origem: {fileID: 1721478011}
    evidencia: {fileID: 0}
    texto: Da ponta destas barracas eu enxergo a picada.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_11
    locutor: Patrulheiro
    quando: 1
    origem: {fileID: 1160380684}
    evidencia: {fileID: 0}
    texto: "Se passarem o caf\xE9 antes da rendi\xE7\xE3o, guardem um dedo pra mim."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_12
    locutor: Patrulheiro
    quando: 1
    origem: {fileID: 1836715148}
    evidencia: {fileID: 0}
    texto: "Passo por tr\xE1s dos jipes. Pela frente a gente atrapalha o motorista."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_13
    locutor: Patrulheiro
    quando: 1
    origem: {fileID: 1624776994}
    evidencia: {fileID: 0}
    texto: A correia range a cada passo. Quando voltar, dou um jeito nisso.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_14
    locutor: Mensageiro
    quando: 1
    origem: {fileID: 998121337}
    evidencia: {fileID: 0}
    texto: "Vou at\xE9 as viaturas. Quer que eu leve o recado?"
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_15
    locutor: Sentinela da entrada
    quando: 1
    origem: {fileID: 497439597}
    evidencia: {fileID: 0}
    texto: Por aqui, camarada. Cuidado com a corda da barraca.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_16
    locutor: "Guarda do dep\xF3sito"
    quando: 1
    origem: {fileID: 61385457}
    evidencia: {fileID: 0}
    texto: Quem deixou esse fuzil aqui? Ainda falta passar o pano.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_17
    locutor: Guarda das viaturas
    quando: 1
    origem: {fileID: 1708618555}
    evidencia: {fileID: 0}
    texto: Deixem essa passagem livre. O jipe precisa dar a volta.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_18
    locutor: "Guarda do posto de sa\xFAde"
    quando: 1
    origem: {fileID: 1658143250}
    evidencia: {fileID: 0}
    texto: "Fale baixo, amigo. Tem gente descansando a\xED dentro."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_19
    locutor: Soldado do rancho
    quando: 1
    origem: {fileID: 1037906448}
    evidencia: {fileID: 0}
    texto: "Guarda uma concha pro pessoal da ronda. Eles comem por \xFAltimo."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_20
    locutor: Soldado das viaturas
    quando: 1
    origem: {fileID: 1350287544}
    evidencia: {fileID: 0}
    texto: Olha o pneu deste lado. Parece mais baixo que o outro.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_21
    locutor: "Soldado da instru\xE7\xE3o"
    quando: 1
    origem: {fileID: 885164233}
    evidencia: {fileID: 0}
    texto: "Deixa um bra\xE7o de dist\xE2ncia do outro. Agora cabe todo mundo."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_22
    locutor: "Soldado do dep\xF3sito"
    quando: 1
    origem: {fileID: 1197280003}
    evidencia: {fileID: 0}
    texto: Contei estas duas vezes. Falta conferir as do fundo.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_23
    locutor: Sentinela da mata
    quando: 1
    origem: {fileID: 1477401819}
    evidencia: {fileID: 0}
    texto: "Ouvi um estalo ali. Espere um pouco\u2026 Foi s\xF3 um galho."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_24
    locutor: "Soldado em instru\xE7\xE3o"
    quando: 1
    origem: {fileID: 1344915288}
    evidencia: {fileID: 0}
    texto: A caneca bate no cinto toda vez que eu salto.
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_25
    locutor: "Soldado em instru\xE7\xE3o"
    quando: 1
    origem: {fileID: 206729138}
    evidencia: {fileID: 0}
    texto: "Em p\xE9 outra vez. Na pr\xF3xima eu alcan\xE7o voc\xEAs."
    audio: {fileID: 0}
    duracaoSemAudio: 0
  - identificador: feb_26
    locutor: "Soldado em instru\xE7\xE3o"
    quando: 1
    origem: {fileID: 335829629}
    evidencia: {fileID: 0}
    texto: "Conta em voz alta, camarada. J\xE1 perdi a conta das minhas."
    audio: {fileID: 0}
    duracaoSemAudio: 0
